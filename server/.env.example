# MongoDB connection string (Atlas in production, local mongod for development)
MONGODB_URI=mongodb://127.0.0.1:27017/learnhub

# JWT secrets — use long random strings in production
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
REFRESH_TOKEN_SECRET=replace-with-another-long-random-string

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

PORT=5050
NODE_ENV=development

# Set to true only for demos without email delivery: returns the reset token
# in the forgot-password response so the reset page can be exercised.
EXPOSE_RESET_TOKEN=false
